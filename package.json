{
  "name": "@cacherocket/next",
  "version": "0.1.0",
  "description": "CacheRocket CDN + cache warming helpers for Next.js (complements Vercel/Netlify hosting)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./image-loader": {
      "types": "./dist/image-loader.d.ts",
      "import": "./dist/image-loader.js",
      "require": "./dist/image-loader.cjs",
      "default": "./dist/image-loader.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "next": "^15.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cacherocket",
    "nextjs",
    "cdn",
    "image",
    "vercel",
    "cache-warming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CacheRocket/cacherocket-next.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
